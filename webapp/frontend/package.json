{
	"name": "frontend",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"lint": "prettier --check . && eslint .",
		"format": "prettier --write .",
		"test:unit": "vitest",
		"test": "npm run test:unit -- --run"
	},
	"engines": {
		"node": ">=22"
	},
	"devEngines": {
		"runtime": {
			"name": "node",
			"version": "^v24.22.0",
			"onFail": "download"
		},
		"packageManager": {
			"name": "npm",
			"version": "^12.0.0",
			"onFail": "download"
		}
	},
	"devDependencies": {
		"@codemirror/autocomplete": "^6.20.4",
		"@codemirror/commands": "^6.11.1",
		"@codemirror/language": "^6.13.1",
		"@codemirror/lint": "^6.9.8",
		"@codemirror/search": "^6.7.2",
		"@codemirror/state": "^6.7.6",
		"@codemirror/view": "^6.43.15",
		"@eslint/config-helpers": "^0.7.0",
		"@eslint/js": "^10.0.1",
		"@fsegurai/codemirror-theme-forest": "^6.3.0",
		"@fsegurai/codemirror-theme-vscode-light": "^6.3.0",
		"@internationalized/date": "^3.12.4",
		"@lezer/common": "^1.5.5",
		"@lezer/generator": "^1.8.1",
		"@lezer/lr": "^1.4.12",
		"@lucide/svelte": "^1.77.0",
		"@sveltejs/adapter-static": "^4.0.1",
		"@sveltejs/kit": "^3.4.0",
		"@sveltejs/load-config": "^0.2.3",
		"@sveltejs/vite-plugin-svelte": "^7.3.2",
		"@tailwindcss/vite": "^4.3.5",
		"@types/node": "^24.19.2",
		"bits-ui": "^2.21.0",
		"clsx": "^2.1.1",
		"codemirror": "^6.0.2",
		"eslint": "^10.15.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-svelte": "^3.24.1",
		"globals": "^17.14.0",
		"mdsvex": "^0.12.8",
		"prettier": "^3.10.1",
		"prettier-plugin-svelte": "^4.2.0",
		"prettier-plugin-tailwindcss": "^0.8.1",
		"svelte": "^5.59.1",
		"svelte-check": "^4.7.8",
		"svelte-sonner": "^1.2.3",
		"tailwind-merge": "^3.7.0",
		"tailwind-variants": "^4.0.2",
		"tailwindcss": "^4.3.3",
		"tw-animate-css": "^1.4.0",
		"typescript": "^6.0.3",
		"typescript-eslint": "^8.73.0",
		"vaul-svelte": "^1.0.0-next.7",
		"vite": "^8.3.8",
		"vitest": "^5.1.1"
	},
	"imports": {
		"#lib": "./src/lib/index.js",
		"#lib/*": "./src/lib/*"
	}
}
