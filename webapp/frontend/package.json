		"@codemirror/search": "^6.7.2",
		"@codemirror/state": "^6.7.6",
		"@codemirror/view": "^6.43.14",
		"@eslint/config-helpers": "^0.7.0",
		"@eslint/js": "^10.0.1",
		"@fsegurai/codemirror-theme-forest": "^6.2.7",
