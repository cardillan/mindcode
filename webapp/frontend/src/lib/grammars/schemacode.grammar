@precedence {
  position,
  block
}

@top Program { definition* }

@skip { space | LineComment | BlockComment }

commaSep<term> { term ("," term)* }
dotSep<term> { term ("." term)* }
kw<term> { @specialize[@name={term}]<Identifier, term> }
mul { @specialize[@name="*"]<Identifier, "*"> }

definition {
  SchematicDefinition |
  StringAssignment
}

SchematicDefinition {
  (Identifier ":")? kw<"schematic"> schematicItem* kw<"end">
}

schematicItem {
  Attribute |
  BlockItem |
  SchematicPrologue |
  RegionDefinition
}

StringAssignment {
  Identifier "=" (String | TextBlock | Identifier)
}

Attribute {
  (kw<"name"> | kw<"description"> | kw<"tag">) "=" (String | TextBlock | Identifier) |
  kw<"filename"> "=" String |
  kw<"dimensions"> "=" Dimensions |
  kw<"target"> "=" (Int | Version)
}

SchematicPrologue {
  (kw<"mindcode"> | kw<"mlog">) "=" (String | TextBlock | Identifier)
}

Region {
  kw<"region"> Dimensions? BlockItem* kw<"end">
}

RegionDefinition {
  Identifier "=" Region
}

BlockItem {
  !block (commaSep<Identifier | ArrayIdentifier> ":")?
    blockElement
    (placementMode (!position blockPosition)?)?
    Reflection?
    Direction?
    Configuration?
}

blockElement {
  Type |
  Identifier |
  Region
}

Reflection {
  kw<"flip"> orientation
}

placementMode {
  kw<"at"> | kw<"fill"> | kw<"replace">
}

position {
  Coordinates |
  RelativeCoordinates |
  CoordinatesRelativeTo
}

orientation {
  kw<"horizontal"> | kw<"vertical">
}

blockPosition {
  position |
  position ".." Coordinates orientation? |
  position "..." Coordinates orientation? |
  position mul Coordinates orientation? |
  position (kw<"odd"> | kw<"even">)? kw<"radius"> Int orientation?
}

// two names just for better code readability
Dimensions {
  "(" Int "," Int ")"
}

Coordinates {
  "(" Int "," Int ")"
}

RelativeCoordinates {
  ("+" | "-") Coordinates
}

CoordinatesRelativeTo {
  Pattern RelativeCoordinates?
}

Pattern {
  dotSep<
    kw<"global"> |
    kw<"local"> |
    kw<"parent"> |
    Identifier |
    ArrayIdentifier |
    LinkPattern { mul } |
    LinkPattern
  >
}

Direction {
  kw<"facing"> (kw<"north"> | kw<"south"> | kw<"east"> | kw<"west">)
}

Configuration {
  kw<"virtual"> |
  kw<"color"> kw<"rgba"> "(" commaSep<Int> ")" |
  kw<"connected"> kw<"to"> ConnectionList |
  kw<"block"> Type |
  kw<"command"> Type |
  kw<"item"> Type |
  kw<"liquid"> Type |
  kw<"unit"> Type |
  kw<"text"> (String | TextBlock | Identifier) |
  kw<"enabled"> |
  kw<"disabled"> |
  ProcessorConfiguration
}

ConnectionList {
  commaSep<connection>
}

connection {
  Coordinates |
  RelativeCoordinates |
  Pattern
}

ProcessorConfiguration {
  kw<"processor"> ProcessorLinks? ProcessorSourceAssignment? ProcessorParametrization? kw<"end">
}

ProcessorSourceAssignment {
  (kw<"mindcode"> | kw<"mlog">) "=" ProcessorSource
}

ProcessorLinks {
  kw<"links"> LinkDef* kw<"end">
}

ProcessorSource {
  processorSourceSnippet ("+" processorSourceSnippet)*
}

processorSourceSnippet {
  (String | TextBlock | Identifier) | FileReference { kw<"file"> (String | TextBlock | Identifier) }
}

LinkDef {
  connection (kw<"as"> (Identifier | ArrayIdentifier) kw<"virtual">?)?
}

@skip {} {
  paramEnd { @specialize[@name="end"]<paramToken, "end"> }

  paramIgnore { paramWhitespace | paramLineComment | paramBlockComment }

  ProcessorParametrization {
    kw<"param"> (processorParameter | paramIgnore)* paramEnd
  }

  processorParameter {
    paramToken paramIgnore* paramAssign paramIgnore* (paramString | paramToken)
  }
}

@local tokens {
  paramAssign[@name="="] { "=" }
  paramBlockComment[@name=BlockComment] { "/*" (![*] | "*" ![/])* "*/" }
  paramLineComment[@name=LineComment] { "//" ![\r\n]* }
  paramWhitespace { @whitespace+ }
  paramString[@name=String] { '"' ![\r\n"]* '"' }
  paramToken[@name=Identifier] { ![ \r\n\t]+ }

  @precedence {
    paramWhitespace,
    paramBlockComment,
    paramLineComment,
    paramAssign,
    paramString,
    paramToken
  }
}




@skip {} {
  String { '"' StringContent { singleLineStringContent* } singleLineStringEnd }
}

@skip {} {
  multilineSingleQuoteString { "'''" TextBlockContent { multilineSingleQuoteStringContent* } multilineSingleQuoteStringEnd }
}

@skip {} {
  multilineDoubleQuoteString { '"""' TextBlockContent { multilineDoubleQuoteStringContent* } multilineDoubleQuoteStringEnd }
}

TextBlock { multilineSingleQuoteString | multilineDoubleQuoteString }

@local tokens {
  singleLineStringEnd { '"' }
  @else singleLineStringContent
}

@local tokens {
  multilineSingleQuoteStringEnd { "'''" }
  @else multilineSingleQuoteStringContent
}

@local tokens {
  multilineDoubleQuoteStringEnd { '"""' }
  @else multilineDoubleQuoteStringContent
}

@tokens {
  space { @whitespace+ }
  LineComment { "//" ![\n]* }
  BlockComment { "/*" (![*] | "*" ![/])* "*/" }
  
  // the only difference between an Identifier and a LinkPattern is that 
  // LinkPattern can contain an asterisk, so the external specializer
  // handles that for us
  Identifier { $[a-zA-Z_*] $[a-zA-Z0-9_\-*]* }
  ArrayIdentifier { $[a-zA-Z_] $[a-zA-Z0-9_\-]* ("#" | "$") }
  Type { "@" $[a-zA-Z_] $[a-zA-Z0-9_\-]* }
  
  Int { ("+" | "-")? $[0-9]+ }
  // Still preserving processor specification support to not break
  // syntax highlighting on old code
  Version { $[0-9]+ "." $[0-9]+ $[a-zA-Z]? | $[0-9]+ $[a-zA-Z] }

  @precedence {
    Version,
    Int
  }

  @precedence {
    ArrayIdentifier,
    Identifier
  }

  "(" ")" "," ":" "." ".." "..." "+" "-" "="
}

@external specialize { Identifier } specializeIdentifier from "./schemacode_tokens" {
  LinkPattern
}