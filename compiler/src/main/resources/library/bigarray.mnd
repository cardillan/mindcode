// Mindcode system library for Mindustry Logic version 8
// BigArray
//
//* Used internally by the Mindcode compiler/Schemacode builder to create processors for large storage.

module bigarray;

/**
 * A list of characters used to generate the variable names.
 */
const chars = "ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz?$&()<=>[]^_";

/**
 * Set to true when code initialization is complete.
 */
export initialized;

volatile mlog(:block) names[256];

inline void _setupName(const index)
    if index < 4096 then
        names[index % 256] = encode(0, char(chars, index \ 64), char(chars, index % 64));
    end;
end;

inline void _setupNames(const i)
    _setupName(i + 0);
    _setupName(i + 1);
    _setupName(i + 2);
    _setupName(i + 3);
    _setupName(i + 4);
    _setupName(i + 5);
    _setupName(i + 6);
    _setupName(i + 7);
    _setupName(i + 8);
    _setupName(i + 9);
    _setupName(i + 10);
    _setupName(i + 11);
    _setupName(i + 12);
    _setupName(i + 13);
    _setupName(i + 14);
    _setupName(i + 15);
end;

/**
 * Creates the code for a BigArray storage processor at the given index. When the index is greater than 15,
 * no name setup code is generated, as such processors only contain data and not a variable name index.
 *
 * @footprint2  Basic usage:      initializeBigArray(0);
 */
inline void initializeBigArray(const index)
    if index in 0 ... 16 then
        const i = 256 * index;
        _setupNames(i + 0);
        _setupNames(i + 16);
        _setupNames(i + 32);
        _setupNames(i + 48);
        _setupNames(i + 64);
        _setupNames(i + 80);
        _setupNames(i + 96);
        _setupNames(i + 112);
        _setupNames(i + 128);
        _setupNames(i + 144);
        _setupNames(i + 160);
        _setupNames(i + 176);
        _setupNames(i + 192);
        _setupNames(i + 208);
        _setupNames(i + 224);
        _setupNames(i + 240);
    end;

    initialized = true;
    wait(1e12);
end;

